# Dockerfile.master — containerized Sift master/coordinator.
#
# Build:
#   docker build -f Dockerfile.master -t Sift-master:0.14.0 .
#
# Run (auto-discovery fleet; workers self-register):
#   docker run --rm --network strike -p 50051:50051 \
#     -e SS_TOKEN="$TOKEN" Sift-master:0.14.0

FROM golang:1.26 AS build

ARG VERSION=0.14.0
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -trimpath -buildvcs=false \
      -ldflags="-s -w -X main.version=${VERSION}" \
      -o /out/Sift-master ./cmd/Sift-master

FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=build /out/Sift-master /usr/local/bin/Sift-master

EXPOSE 50051
ENTRYPOINT ["/usr/local/bin/Sift-master"]
CMD ["-listen", "0.0.0.0:50051"]