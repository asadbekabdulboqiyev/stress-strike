# Build context is copied into the Docker image; keep it lean and secret-free.

# Build & test artifacts
bin/
dist/
reports/
coverage.out
coverage.html
*.test
*.exe
/stress-strike

# VCS & CI
.git/
.gitignore
.github/

# Secrets
.env
*.env

# Editor / temporary files
.DS_Store
*.swp
*.tmp

# Docs & meta (not needed at runtime)
LICENSE
SECURITY.md
README.md
examples/
scripts/

# Host deployment files (systemd units, fleet templates) — not needed in the image
deploy/
