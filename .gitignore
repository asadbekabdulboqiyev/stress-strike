bin/
reports/
# Test/demo reports and artifacts — never commit generated scan results.
cmd/sift/reports/
# Build output only! Root-anchored so source under internal/dist/ (the
# distributed control plane) is NOT ignored — a bare `dist/` pattern would
# swallow internal/dist/ and hide the whole subsystem from version control.
/dist/
/Sift
/Sift-master
/Sift-worker
/Sift-dashboard
/Sift-replay
/Sift-scan
# `go build ./examples/demo_store/...` from the repo root drops a binary here.
/demo_store
/demo-store
# gosec writes its SARIF report here (make gosec, and the Security workflow).
# The ratchet baseline, .gosec-baseline.json, IS committed on purpose.
/gosec.sarif
*.test
*.out
coverage.html
.DS_Store

# Secrets
.env
*.env
