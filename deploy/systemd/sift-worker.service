[Unit]
Description=Sift distributed load worker
Documentation=https://github.com/asadbekabdulboqiyev/sift
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Copy worker.env.example to /etc/Sift/worker.env and edit it.
EnvironmentFile=-/etc/Sift/worker.env
ExecStart=/usr/local/bin/Sift-worker $WORKER_ARGS
Restart=on-failure
RestartSec=3

# A load generator opens a very large number of sockets; raise the limits.
LimitNOFILE=1048576
LimitNPROC=65535

# Run unprivileged. Create these users/group first:
#   sudo groupadd --system Sift
#   sudo useradd  --system --gid Sift --no-create-home Sift
User=Sift
Group=Sift

# Basic hardening — the worker only needs outbound network + ephemeral ports.
NoNewPrivileges=true
ProtectSystem=strict
# Worker writes reports under /var/lib/Sift; allow writes there only.
ReadWritePaths=/var/lib/Sift
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
