# Environment for the stress-strike-worker systemd unit.
#
# Install:
#   sudo mkdir -p /etc/stress-strike
#   sudo cp worker.env.example /etc/stress-strike/worker.env
#   sudo chmod 600 /etc/stress-strike/worker.env
#   sudo editor /etc/stress-strike/worker.env
#
# WORKER_ARGS is expanded by systemd as the worker command line. Set exactly the
# flags you need. Keep the value on ONE line.

# Static fleet: master connects to this worker directly.
WORKER_ARGS=-listen 0.0.0.0:50061 -id worker-1 -max-users 200000 -max-runs 4

# Auto-discovery: uncomment -master (and -token) so this worker self-registers
# with the master; the master is then started with `-wait-workers N`.
# WORKER_ARGS=-listen 0.0.0.0:50061 -id worker-1 -max-users 200000 -max-runs 4 -master master.internal:50051 -advertise 10.0.0.11:50061

# Shared control-plane token. When the master is started with -token, every
# worker MUST use the SAME value or registration/command traffic is rejected.
# TOKEN=change-me

# Optional: raise socket limits via systemd is preferred; these are for shells.
# GOMAXPROCS=0
