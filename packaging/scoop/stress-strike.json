{
    "version": "0.14.3",
    "description": "Distributed load testing and network simulator written in Go",
    "homepage": "https://github.com/asadbekabdulboqiyev/Sift",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/asadbekabdulboqiyev/Sift.git"
    },
    "notes": [
        "Pure Go build: no libpcap, no C runtime, no system dependencies.",
        "To reach high virtual-user counts on Windows, raise the file-descriptor equivalent (dynamic port range) or run the worker under WSL2."
    ],
    "checkver": {
        "url": "https://github.com/asadbekabdulboqiyev/Sift/releases/latest",
        "regex": "tag/v([0-9.]+)"
    },
    "bin": [
        "Sift.exe"
    ],
    "url": {
        "x64": "https://github.com/asadbekabdulboqiyev/Sift/releases/download/v0.14.3/Sift_0.14.3_windows_amd64.zip",
        "arm64": "https://github.com/asadbekabdulboqiyev/Sift/releases/download/v0.14.3/Sift_0.14.3_windows_arm64.zip"
    },
    "hash": {
        "x64": "REPLACE_WITH_SHA256_FROM_checksums_txt",
        "arm64": "REPLACE_WITH_SHA256_FROM_checksums_txt"
    },
    "autoupdate": {
        "x64": "https://github.com/asadbekabdulboqiyev/Sift/releases/download/v{{version}}/Sift_{{version}}_windows_amd64.zip",
        "arm64": "https://github.com/asadbekabdulboqiyev/Sift/releases/download/v{{version}}/Sift_{{version}}_windows_arm64.zip",
        "hash": {
            "x64": "https://github.com/asadbekabdulboqiyev/Sift/releases/download/v{{version}}/checksums.txt",
            "arm64": "https://github.com/asadbekabdulboqiyev/Sift/releases/download/v{{version}}/checksums.txt"
        }
    }
}
